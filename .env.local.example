# Railway public URL, no trailing slash
COORDINATOR_URL=https://jna-permit-bot-production.up.railway.app

# Must exactly match AGENT_SHARED_SECRET in Railway Variables
AGENT_SHARED_SECRET=replace-with-a-long-random-secret

# Keep these only on the office computer
DLD_USERNAME=your-dld-username
DLD_PASSWORD=your-dld-password
UAE_PASS_EMIRATES_ID=your-emirates-id

# Optional local storage location; defaults to ~/.jna-permit-bot
# JNA_LOCAL_DATA_DIR=/Users/yourname/.jna-permit-bot
